// NORA — Prisma schema
// Phase 1 scope: authentication & core User model only.
// Incident, Resource, Alert, etc. (see section 12 of the master prompt) land in later phases.
// PostGIS is enabled on the postgis/postgis Docker image; the `postgresqlExtensions`
// preview feature is intentionally NOT used here — it caused a P1010 permission error
// during `migrate dev` in local testing. Geometry columns will be added via a manual
// SQL migration (`CREATE EXTENSION IF NOT EXISTS postgis;`) when Phase 2 needs them.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────

enum Role {
  CITIZEN
  OPERATOR
  ADMIN
}

// ── Models ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(CITIZEN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Minimal audit trail (section 25/34 — expanded in later phases).
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}
