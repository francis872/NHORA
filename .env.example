# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=nora
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=nora
# 5544 avoids clashing with native PostgreSQL installs on the host (this repo
# hit collisions with existing services on both 5432 and 5433).
POSTGRES_PORT=5544
DATABASE_URL=postgresql://nora:change-me-in-local-env@localhost:5544/nora?schema=public

# ── API (apps/api) ──────────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development

# JWT — generate real secrets locally, never commit them
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000

# ── Web (apps/web) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
